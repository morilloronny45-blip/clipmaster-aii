<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#080d18">
  <meta name="description" content="ClipMaster AI - Herramienta personal para crear clips de video.">
  <title>ClipMaster AI</title>
  <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
</head>
<body>
  <div class="app-shell">
    <aside class="sidebar">
      <div class="brand">
        <div class="brand-icon">CM</div>
        <div>
          <h2>ClipMaster <span>AI</span></h2>
          <small>VIDEO STUDIO</small>
        </div>
      </div>

      <div class="side-label">MENÚ PRINCIPAL</div>
      <nav>
        <a class="nav-link active" href="#inicio">
          <span>▦</span> Panel principal
        </a>
        <a class="nav-link" href="#crear">
          <span>✂</span> Crear clips
        </a>
      </nav>

      <div class="sidebar-bottom">
        <div class="personal-card">
          <span class="status-dot"></span>
          <div>
            <strong>Espacio personal</strong>
            <small>Tu estudio de videos</small>
          </div>
        </div>
        <p class="version">CLIPMASTER AI · 1.0</p>
      </div>
    </aside>

    <main class="main-content" id="inicio">
      <header class="topbar">
        <div>
          <span class="eyebrow">TU ESTUDIO DE EDICIÓN</span>
          <h1>Panel principal</h1>
        </div>
        <div class="top-status">
          <span class="status-dot"></span>
          Sistema disponible
        </div>
      </header>

      <section class="welcome">
        <div>
          <span class="welcome-tag">BIENVENIDO A CLIPMASTER AI</span>
          <h2>Convierte tus videos en <span>clips</span></h2>
          <p>Procesa tus videos y crea segmentos listos para descargar.</p>
        </div>
        <div class="welcome-art">✂</div>
      </section>

      <section class="workspace" id="crear">
        <div class="section-heading">
          <div>
            <span class="eyebrow">PROCESAMIENTO DE VIDEO</span>
            <h2>Crear nuevos clips</h2>
          </div>
          <span class="private-label">USO PERSONAL</span>
        </div>

        <form id="processForm">
          <div class="input-panel">
            <label for="videoUrl">Enlace del video</label>
            <div class="url-input-wrap">
              <span class="input-icon">↗</span>
              <input
                type="url"
                id="videoUrl"
                name="url"
                placeholder="Pega aquí tu enlace de YouTube, Facebook o TikTok"
              >
            </div>
            <p class="help-text">También puedes subir un video desde tu dispositivo.</p>

            <div class="or-divider"><span>O SUBE UN ARCHIVO</span></div>

            <label class="upload-area" for="videoFile">
              <span class="upload-icon">↑</span>
              <strong>Seleccionar video</strong>
              <span id="fileName">MP4, MOV, MKV o WEBM · Máximo 2 GB</span>
              <input type="file" id="videoFile" name="video"
                accept=".mp4,.mov,.mkv,.webm,.m4v,video/*">
            </label>
          </div>

          <div class="settings-panel">
            <label for="segment">Duración de cada clip</label>
            <select id="segment" name="segment">
              <option value="30">30 segundos</option>
              <option value="60" selected>60 segundos</option>
              <option value="90">90 segundos</option>
            </select>
            <p class="help-text">El video se dividirá en segmentos consecutivos.</p>
          </div>

          <button type="submit" id="processButton" class="primary-button">
            <span>✂</span> Crear mis clips
          </button>
        </form>

        <div id="statusBox" class="status-box" hidden aria-live="polite"></div>
      </section>

      <section class="results-section" id="resultsSection" hidden>
        <div class="section-heading">
          <div>
            <span class="eyebrow">RESULTADO DEL PROCESAMIENTO</span>
            <h2>Tus clips</h2>
          </div>
          <span id="clipCount" class="clip-count"></span>
        </div>
        <div id="clipsList" class="clips-list"></div>
      </section>

      <footer>
        <span>ClipMaster AI</span>
        <span>Tu espacio personal de edición de video.</span>
      </footer>
    </main>
  </div>

  <script src="{{ url_for('static', filename='app.js') }}"></script>
</body>
</html>
